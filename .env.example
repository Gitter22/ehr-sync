# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Docker Compose (containers talking to the `postgres` service):
#   DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<db>
# Local development against a host-installed PostgreSQL:
#   DATABASE_URL=postgresql://<user>:<password>@localhost:<port>/<db>
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# ---------------------------------------------------------------------------
# Node API (apps/api)
# ---------------------------------------------------------------------------
API_PORT=
# URL the Node API uses to reach the Python service.
# Docker Compose: http://python:<PYTHON_PORT>  |  Local dev: http://localhost:<PYTHON_PORT>
PYTHON_SERVICE_URL=
CORS_ORIGIN=

# FHIR sync engine — HAPI FHIR sandbox (public, no auth). Optional; defaults to
# https://hapi.fhir.org/baseR4 if unset.
HAPI_FHIR_BASE_URL=

# FHIR sync engine — Oracle Health provider. All optional; leave unset to keep source=ORACLE_HEALTH
# disabled (POST /api/sync for it fails with a clear "not configured" error instead of the app
# refusing to start). Uses a standard SMART-on-FHIR backend-services client-credentials grant.
ORACLE_FHIR_BASE_URL=
ORACLE_TOKEN_URL=
ORACLE_CLIENT_ID=
ORACLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Python service (apps/python)
# ---------------------------------------------------------------------------
PYTHON_PORT=
# Python connects to Postgres directly; reuses DATABASE_URL above.

# ---------------------------------------------------------------------------
# Web (apps/web) — VITE_-prefixed vars are exposed to the browser bundle.
# Never put secrets here.
# ---------------------------------------------------------------------------
VITE_API_URL=
# Docker Compose only: host-side port the nginx-served build is published on
# (container-internal port is always 80, fixed).
WEB_PORT=
